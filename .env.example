# Base URL of the Wiki.js instance, no trailing slash.
# e.g. https://wiki.epflrocketteam.ch
WIKI_BASE_URL=

# Read-only API token generated in Wiki.js: Admin -> API Access
WIKI_API_TOKEN=

# Port the service listens on (Dokploy will map this)
PORT=4000

# Cron schedule for rebuilding the link graph (node-cron syntax).
# Default: every 6 hours.
REBUILD_CRON=0 */6 * * *

# Shared secret required (as `x-rebuild-secret` header) to call POST /api/rebuild
# on demand, e.g. from a Wiki.js webhook on page save. Generate your own random value.
REBUILD_SECRET=

# How many pages to fetch from the Wiki.js API concurrently while rebuilding
# the graph. Keep this modest so we don't hammer the wiki's own server.
FETCH_CONCURRENCY=5

# Default neighbor depth for GET /api/graph/:pageId when ?depth= is not given
DEFAULT_GRAPH_DEPTH=1

# Origin allowed to call the API via CORS (the browser-side fetch() from the
# button injected into the wiki). Leave empty to default to WIKI_BASE_URL --
# only set this explicitly if the wiki is served from a different origin
# than WIKI_BASE_URL, or to also allow a local dev copy of the wiki.
ALLOWED_ORIGIN=
